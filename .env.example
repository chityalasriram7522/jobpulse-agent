# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Adzuna Jobs API Configuration (https://developer.adzuna.com/)
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# Mobile Push Notifications via ntfy (Option A - Zero keys needed)
NTFY_TOPIC=jobpulse-sriram-chityala

# Telegram Bot Configuration (Optional if using ntfy)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
